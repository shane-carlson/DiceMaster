{
  "name": "dicemaster",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,magenta \"tsx watch --exclude ./data/** --exclude ./dist/** server/index.ts\" \"vite\"",
    "dev:web": "vite",
    "dev:api": "tsx watch --exclude ./data/** --exclude ./dist/** server/index.ts",
    "start": "tsx server/index.ts",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@react-three/drei": "^10.0.6",
    "@react-three/fiber": "^9.1.2",
    "hono": "^4.13.2",
    "jszip": "^3.10.1",
    "manifold-3d": "^3.5.1",
    "opentype.js": "^1.3.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.5.0",
    "three": "^0.175.0",
    "three-mesh-bvh": "^0.8.3",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/opentype.js": "^1.3.8",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@types/three": "^0.175.0",
    "@vitejs/plugin-react": "^4.4.1",
    "concurrently": "^10.0.4",
    "tsx": "^4.23.12",
    "typescript": "^5.8.3",
    "vite": "^6.3.2",
    "vitest": "^3.1.1"
  }
}
